+// Milestone 11, step 5's console diagnostics: GX draws counted, and skipped, by the features step 5 drew. Bits:
+// lit, fog, range fog, indirect, PNMTXIDX, TEXnMTXIDX, none of them.
+constexpr size_t FeatureCount = 7;
+std::atomic<uint32_t> g_skipFeatures = 0;
+std::array<std::atomic<uint64_t>, FeatureCount> g_featureDraws{};
+std::array<std::atomic<uint64_t>, FeatureCount> g_featureVertices{};
+// The second run's: texture uploads and their bytes, EFB copies and render passes.
+std::array<std::atomic<uint64_t>, 4> g_frameWork{};
+
+uint32_t draw_features(const gx::ShaderConfig& config) noexcept {
+  uint32_t features = 0;
+  for (const auto& channel : config.colorChannels) {
+    if (channel.lightingEnabled) {
+      features |= 1;
+    }
+  }
+  if (config.fogType != GX_FOG_NONE) {
+    features |= 2;
+  }
+  if (config.fogRangeEnabled) {
+    features |= 4;
+  }
+  if (config.numIndStages != 0) {
+    features |= 8;
+  }
+  if (config.attrs[GX_VA_PNMTXIDX].attrType != GX_NONE) {
+    features |= 16;
+  }
+  for (u32 attr = GX_VA_TEX0MTXIDX; attr <= GX_VA_TEX7MTXIDX; ++attr) {
+    if (config.attrs[attr].attrType != GX_NONE) {
+      features |= 32;
+    }
+  }
+  return features == 0 ? 64 : features;
+}
 #endif
 
