+// The processor control region, which r13 points at (docs/HARDWARE.md, 0x801B0000): the caller's hardware thread and
+// its KTHREAD (xenia:src/xenia/kernel/xthread.h:81-83). The toolchain never allocates r13 (GCC's System V target).
+static inline volatile uint8_t *xsdk_processor_control_region(void)
+{
+	uint32_t region;
+	__asm__ volatile("mr %0, 13" : "=r"(region));
+	return (volatile uint8_t *)(uintptr_t)region;
+}
+static inline uint32_t xsdk_current_hardware_thread(void)
+{
+	return xsdk_processor_control_region()[0x10C];
+}
+static inline void *xsdk_current_kthread(void)
+{
+	return (void *)(uintptr_t)*(volatile uint32_t *)(xsdk_processor_control_region() + 0x100);
+}
