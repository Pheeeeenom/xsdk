--- a/newlib/libc/include/sys/features.h
+++ b/newlib/libc/include/sys/features.h
@@ -439,6 +439,18 @@
 #define _POSIX_THREAD_PRIORITY_SCHEDULING	1
 #endif
 
+/* The Xbox 360 SDK supplies POSIX threads, their scheduling, timeouts and clocks on the retail kernel. */
+#ifdef __XSDK__
+#define _POSIX_THREADS				1
+#define _POSIX_PRIORITY_SCHEDULING		1
+#define _POSIX_THREAD_PRIORITY_SCHEDULING	1
+#define _POSIX_READER_WRITER_LOCKS		200112L
+#define _POSIX_TIMEOUTS				1
+#define _POSIX_TIMERS				1
+#define _POSIX_MONOTONIC_CLOCK			200112L
+#define _UNIX98_THREAD_MUTEX_ATTRIBUTES		1
+#endif
+
 
 #ifdef __svr4__
 # define _POSIX_JOB_CONTROL     1
--- a/newlib/libc/include/sys/dirent.h
+++ b/newlib/libc/include/sys/dirent.h
@@ -7,7 +7,34 @@
 #ifdef __cplusplus
 extern "C" {
 #endif
+#ifdef __XSDK__
+/* The Xbox 360 SDK lists directories through the retail kernel. */
+#include <sys/types.h>
+
+#define DT_UNKNOWN	0
+#define DT_FIFO		1
+#define DT_CHR		2
+#define DT_DIR		4
+#define DT_BLK		6
+#define DT_REG		8
+#define DT_LNK		10
+#define DT_SOCK		12
+
+struct dirent {
+	ino_t d_ino;
+	unsigned char d_type;
+	char d_name[256];
+};
+
+typedef struct __xsdk_dir DIR;
+
+DIR *opendir(const char *);
+struct dirent *readdir(DIR *);
+void rewinddir(DIR *);
+int closedir(DIR *);
+#else
 #error "<dirent.h> not supported"
+#endif
 #ifdef __cplusplus
 }
 #endif
--- a/newlib/configure.host
+++ b/newlib/configure.host
@@ -823,6 +823,11 @@
 	default_newlib_io_long_long="yes"
 	newlib_cflags="${newlib_cflags} -DMISSING_SYSCALL_NAMES"
 	;;
+  powerpc*-xsdk-*)
+	# The Xbox 360 SDK links titles at a fixed address, so newlib needn't relocate itself (-mrelocatable-lib).
+	default_newlib_io_long_long="yes"
+	newlib_cflags="${newlib_cflags} -mno-eabi -mstrict-align -DMISSING_SYSCALL_NAMES"
+	;;
   powerpc*-*-eabi* | \
   powerpc*-*-elf* | \
   powerpc*-*-linux* | \
