@@ -186,7 +186,12 @@
 #endif
 
 #ifdef __PPC__
-#ifdef __powerpc64__
+#if defined(_CALL_XSDK)
+/* The Xbox 360 SDK's calling convention keeps r14-r31 whole and v14-v31: up
+   to 15 bytes to align, r1, r2, r13-r31, LR and CR in 192, f14-f31 in 144,
+   16 more to align and v14-v31 in 288.  */
+#define _JBLEN 82
+#elif defined(__powerpc64__)
 #ifdef __ALTIVEC__
 #define _JBLEN 70
