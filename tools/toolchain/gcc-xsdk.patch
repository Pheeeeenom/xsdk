+/* Xbox 360 SDK: 32-bit frames save GPRs, LR, CTR and VRSAVE as words even
+   with -mpowerpc64.  The default sizes those registers for the unwinder as
+   8 bytes, or as 0 for call-clobbered GPRs, so installing a handler's
+   context copied the wrong amount and C++ exceptions crashed.  */
+
+static machine_mode
+rs6000_dwarf_frame_reg_mode (int regno)
+{
+  if (TARGET_32BIT
+      && (INT_REGNO_P (regno) || regno == LR_REGNO || regno == CTR_REGNO
+	  || regno == VRSAVE_REGNO))
+    return SImode;
+  return default_dwarf_frame_reg_mode (regno);
+}
